[gd_resource type="Resource" script_class="UpgradeDefinition" format=3]

[ext_resource type="Script" path="res://upgrades/upgrade_effect.gd" id="1_o5wdr"]
[ext_resource type="Script" path="res://upgrades/effects/toxic_cloud_effect.gd" id="2_qcnt8"]
[ext_resource type="Script" path="res://upgrades/upgrade_definition.gd" id="3_foa81"]
[ext_resource type="Script" path="res://stats/stat_modifier.gd" id="4_u8ldu"]

[sub_resource type="Resource" id="Resource_yraic"]
script = ExtResource("2_qcnt8")

[sub_resource type="Resource" id="Resource_bfct0"]
